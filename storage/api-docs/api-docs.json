                                                    "type": {
                                                        "type": "string",
                                                        "example": "income"
                                                    },
                                                    "amount": {
                                                        "type": "number",
                                                        "example": 50000
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Membeli makan siang",
                                                        "nullable": true
                                                    },
                                                    "transaction_date": {
                                                        "type": "string",
                                                        "example": "2026-11-20"
